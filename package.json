{
  "name": "print-agent-desktop",
  "version": "1.0.0",
  "description": "Windows desktop print agent with local admin UI and HTTP print API.",
  "author": "Print Agent Team",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build --base ./ --outDir dist/renderer --emptyOutDir",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "prepare:installer-packages": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-installer-packages.ps1",
    "pack": "npm run build && electron-builder --dir",
    "pack:offline": "npm run prepare:installer-packages && npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:offline": "npm run prepare:installer-packages && npm run build && electron-builder"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "build": {
    "appId": "app.printagent.desktop",
    "productName": "Print Agent",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/installer",
        "to": "installer",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "iconv-lite": "^0.6.3",
    "pdfkit": "^0.17.2"
  }
}
